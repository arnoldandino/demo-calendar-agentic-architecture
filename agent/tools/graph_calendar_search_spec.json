{
  "openapi": "3.0.1",
  "info": {
    "title": "Microsoft Graph Calendar Search Tool",
    "version": "v1.0"
  },
  "servers": [
    {
      "url": "https://graph.microsoft.com/v1.0"
    }
  ],
  "paths": {
    "/me/calendarView": {
      "get": {
        "operationId": "SearchCalendarEvents",
        "summary": "Search user calendar events across a specific time window",
        "parameters": [
          {
            "name": "startDateTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDateTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of calendar events returned from Exchange Online",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "subject": { "type": "string" },
                          "start": { "type": "object" },
                          "end": { "type": "object" },
                          "organizer": { "type": "object" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "EntraIDOAuth": ["Calendars.Read"]
          }
        ]
      }
    }
  }
}
