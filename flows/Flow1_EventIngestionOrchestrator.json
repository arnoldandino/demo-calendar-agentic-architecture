{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    }
  },
  "triggers": {
    "When_a_new_event_is_created": {
      "type": "OpenApiConnectionNotification",
      "inputs": {
        "host": {
          "connectionName": "shared_office365",
          "operationId": "V3CalendarEventCreated",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
        },
        "parameters": {
          "table": "Calendar"
        }
      }
    }
  },
  "actions": {
    "Assemble_Agent_Context": {
      "runAfter": {},
      "type": "Compose",
      "inputs": {
        "eventId": "@triggerOutputs()?['body/id']",
        "subject": "@triggerOutputs()?['body/subject']",
        "start": "@triggerOutputs()?['body/start']",
        "end": "@triggerOutputs()?['body/end']",
        "organizer": "@triggerOutputs()?['body/organizer']"
      }
    },
    "Invoke_Copilot_Studio_Agent": {
      "runAfter": {
        "Assemble_Agent_Context": ["Succeeded"]
      },
      "type": "Http",
      "inputs": {
        "method": "POST",
        "uri": "https://powerva.microsoft.com/api/v1/bots/calendar-agent/conversations",
        "body": {
          "message": "New calendar event detected: @{outputs('Assemble_Agent_Context')}. Evaluate conflicts against Dataverse rules and propose resolution."
        },
        "authentication": {
          "type": "ActiveDirectoryOAuth",
          "tenant": "@parameters('$tenantId')",
          "audience": "https://powerva.microsoft.com"
        }
      }
    }
  }
}
